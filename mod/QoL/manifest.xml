<?xml version="1.0" encoding="utf-8"?>
<!--
  模组清单。加载器靠这个文件识别模组，文件名必须是 manifest.xml，
  并且和 DLL 放在同一个文件夹里。

  ID        全局唯一，建议用 作者名.模组名 的格式
  ModVersion 模组版本（显示在游戏里的模组列表）
  GameVersions 适配的游戏版本，写 0.46D 这类
  Assemblies 要加载的 DLL 文件名，必须和实际文件名一致
  Capabilities 申请的能力：留空表示普通模组；
               需要读写文件才写 files，联网写 network
-->
<Mod>
  <ID>local.qol</ID>
  <Name>深空当铺 · 我的整合模组</Name>
  <Author>我自己</Author>
  <ModVersion>0.1.0</ModVersion>
  <GameVersions>
    <Version>0.46D</Version>
  </GameVersions>
  <Description>深空当铺实用功能整合：更清楚的提示、更省事的交易与快捷操作。每项都能在设置里单独开关，改完立即生效。</Description>
  <Prerequisites />
  <Assemblies>
    <Assembly>QoL.dll</Assembly>
  </Assemblies>
  <Capabilities />
</Mod>
